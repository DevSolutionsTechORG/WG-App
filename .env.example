DATABASE_URL=mongodb://127.0.0.1/your-database-name

# At least 32 characters. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE_AT_LEAST_32_CHARS

# Optional: Auto-login for local Payload admin (development only).
# AUTOLOGIN_EMAIL=
# AUTOLOGIN_PASSWORD=

# Optional: exakte Origin der App in Produktion (ohne Slash am Ende), z.B. https://wg.example.de
# Wenn gesetzt, akzeptiert Payload das Login-Cookie nur noch von dieser Origin (CSRF-Härtung).
# SERVER_URL=

# Push-Benachrichtigungen (optional; ohne diese drei Werte ist Push deaktiviert).
# Schlüsselpaar erzeugen: pnpm exec web-push generate-vapid-keys
# VAPID_SUBJECT muss eine echte mailto:- oder https:-Adresse sein (Apple lehnt sonst ab).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@example.de
